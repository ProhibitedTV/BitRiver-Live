# Copy to deploy/monitoring/alertmanager.env and set receiver endpoints/tokens.
BITRIVER_ALERTMANAGER_DEFAULT_WEBHOOK_URL=https://hooks.example.invalid/default
BITRIVER_ALERTMANAGER_DEFAULT_WEBHOOK_TOKEN=replace-default-token
BITRIVER_ALERTMANAGER_CRITICAL_WEBHOOK_URL=https://hooks.example.invalid/critical
BITRIVER_ALERTMANAGER_CRITICAL_WEBHOOK_TOKEN=replace-critical-token
BITRIVER_ALERTMANAGER_AUTH_WEBHOOK_URL=https://hooks.example.invalid/auth
BITRIVER_ALERTMANAGER_AUTH_WEBHOOK_TOKEN=replace-auth-token
