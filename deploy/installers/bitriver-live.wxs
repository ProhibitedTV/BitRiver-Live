<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="BitRiver Live" Language="1033" Version="$(var.ProductVersion)" Manufacturer="BitRiver" UpgradeCode="2A1A9B76-4D2E-4E38-9A32-AC3C06C24B9C">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="BitRiver Live">
          <Component Id="LauncherFiles" Guid="6C1C2F0C-594B-4D3B-91B5-6CFA3CF4C5E2">
            <File Id="BitriverExe" Source="$(var.SourceDir)\bin\bitriver.exe" KeyPath="yes" />
            <File Id="WrapperScript" Source="$(var.SourceDir)\bin\bitriver-live.ps1" />
          </Component>
          <Directory Id="SHAREDIR" Name="share">
            <Directory Id="RELEASEASSETSDIR" Name="bitriver-live" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="BitRiver Live">
          <Component Id="ProgramMenuShortcuts" Guid="0569546C-AB76-4FEE-9F14-6BFA48D80D65">
            <Shortcut Id="ProgramMenuShortcut" Name="Start BitRiver Live" Description="Launch BitRiver Live stack" Target="[SystemFolder]WindowsPowerShell\\v1.0\\powershell.exe" Arguments="-ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]bitriver-live.ps1&quot;" WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveProgramsMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\\BitRiverLive" Name="ProgramMenu" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop">
        <Component Id="DesktopShortcutComponent" Guid="D20544E4-834F-45B2-9E54-8D07403C1F76">
          <Shortcut Id="DesktopShortcut" Name="Start BitRiver Live" Description="Launch BitRiver Live stack" Target="[SystemFolder]WindowsPowerShell\\v1.0\\powershell.exe" Arguments="-ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]bitriver-live.ps1&quot;" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\\BitRiverLive" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="BitRiver Live" Level="1">
      <ComponentRef Id="LauncherFiles" />
      <ComponentGroupRef Id="ReleaseAssets" />
      <ComponentRef Id="ProgramMenuShortcuts" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Product>
</Wix>
