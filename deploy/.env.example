# Copy this file to ../.env and replace the placeholder values before starting the stack.
# deploy/check-env.sh and cmd/bitriver env validate refuse to start when any sample
# credential from this template remains. Regenerate secrets (or run
# cmd/bitriver env init) before docker compose up.

# Core service configuration
# Image source strategy for compose/quickstart orchestration.
# pull (recommended production default): verify GHCR auth/manifests, then run pull-only compose.
# build: skip pull preflight and build local sources intentionally.
BITRIVER_DEPLOY_IMAGE_SOURCE=pull
# Required: set the image tags to the release version you extracted (for
# example, v1.2.3). SRS is pinned to v5.0.185 by default to match the systemd
# units; bump it only after validating a newer upstream tag. OME defaults to
# 0.16.0 and requires a non-empty API token that matches the managers auth
# block in deploy/ome/Server.xml. The rendered deploy/ome/Server.generated.xml
# records this tag and the quickstart will force a regeneration if they ever
# diverge. Use BITRIVER_OME_API_TOKEN as the authoritative token and set
# BITRIVER_OME_HEALTHCHECK_TOKEN only for temporary healthcheck overrides.
BITRIVER_LIVE_IMAGE_TAG=v1.2.3
BITRIVER_VIEWER_IMAGE_TAG=v1.2.3
BITRIVER_SRS_CONTROLLER_IMAGE_TAG=v1.2.3
BITRIVER_TRANSCODER_IMAGE_TAG=v1.2.3
BITRIVER_SRS_IMAGE_TAG=v5.0.185
BITRIVER_OME_IMAGE_TAG=0.16.0
# Optional: pin container images to immutable digests in production.
# Use the full digest string (for example, @sha256:...) and keep the tag/digest aligned.
# Release builds should record the resolved digests in release notes or update this template.
BITRIVER_LIVE_IMAGE_DIGEST=
BITRIVER_VIEWER_IMAGE_DIGEST=
BITRIVER_SRS_CONTROLLER_IMAGE_DIGEST=
BITRIVER_TRANSCODER_IMAGE_DIGEST=
BITRIVER_SRS_IMAGE_DIGEST=
BITRIVER_OME_IMAGE_DIGEST=
BITRIVER_REDIS_IMAGE_DIGEST=
BITRIVER_POSTGRES_IMAGE_DIGEST=
BITRIVER_NGINX_IMAGE_DIGEST=
BITRIVER_ALPINE_3_IMAGE_DIGEST=
BITRIVER_ALPINE_3_19_IMAGE_DIGEST=
BITRIVER_DEBIAN_IMAGE_DIGEST=
BITRIVER_LIVE_PORT=8080
BITRIVER_LIVE_STORAGE_DRIVER=postgres
# Controls how Docker builds source pgx: use real for Postgres-capable quickstarts,
# or stub for fully offline/json-only local builds.
BITRIVER_PGX_MODE=real
# Deployment defaults enforce production mode; deploy/check-env.sh fails when this is empty or set to development.
# Keep the primary .env at production and override BITRIVER_LIVE_MODE via an inline env var or compose override file when
# you intentionally need HTTP-only demos.
BITRIVER_LIVE_MODE=production
BITRIVER_LIVE_ADDR=:8080
BITRIVER_LIVE_ALLOW_SELF_SIGNUP=false
# Protect the /metrics endpoint with a bearer token (recommended alongside the allowlist below).
BITRIVER_LIVE_METRICS_TOKEN=metrics-collector-token
# Optionally add CIDR blocks or IPs that are allowed to scrape /metrics in addition to (or instead of) the token.
# BITRIVER_LIVE_METRICS_ALLOW_NETWORKS=10.0.0.0/8,192.168.0.0/16
# Required in production: enforce login throttling to slow password sprays.
# Adjust the window to suit your auth posture (for example, 1m or 5m) and raise the limit cautiously for high-traffic sites.
BITRIVER_LIVE_RATE_LOGIN_LIMIT=10
BITRIVER_LIVE_RATE_LOGIN_WINDOW=1m
# Reverse-proxy client-IP trust for rate limiting. Keep disabled unless you pin
# every trusted proxy CIDR/IP in BITRIVER_LIVE_RATE_TRUSTED_PROXIES.
BITRIVER_LIVE_RATE_TRUST_FORWARDED_HEADERS=false
# Comma-separated CIDRs/IPs that may set X-Forwarded-For / Forwarded values.
# Example (single proxy): BITRIVER_LIVE_RATE_TRUSTED_PROXIES=10.0.10.5/32
# Example (Cloudflare + NPM):
# BITRIVER_LIVE_RATE_TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,10.0.10.5/32
BITRIVER_LIVE_RATE_TRUSTED_PROXIES=
# Upload media URL forwarding trust. Leave false unless requests pass through
# a pinned trusted proxy chain and forwarded Host/Proto headers are sanitized.
BITRIVER_LIVE_UPLOADS_TRUST_FORWARDED_HEADERS=false
BITRIVER_LIVE_UPLOAD_MEDIA_BASE_URL=
# Compose derives BITRIVER_LIVE_POSTGRES_DSN from the credentials below when left unset.
# Uncomment to override with a custom connection string.
# BITRIVER_LIVE_POSTGRES_DSN=postgres://${BITRIVER_POSTGRES_USER}:${BITRIVER_POSTGRES_PASSWORD}@postgres:5432/${BITRIVER_POSTGRES_DB}?sslmode=disable
# For external Postgres, require TLS (sslmode=require or verify-full) and add sslrootcert=/certs/postgres-ca.pem when using a private CA.
# Rotate these before production to keep them in sync.
BITRIVER_POSTGRES_DB=brlive_app
BITRIVER_POSTGRES_USER=brlive_app
BITRIVER_POSTGRES_PASSWORD=P0stgres-Example!
BITRIVER_REDIS_PASSWORD=R3dis-Example!
BITRIVER_LIVE_POSTGRES_MAX_CONNS=15
BITRIVER_LIVE_POSTGRES_MIN_CONNS=5
BITRIVER_LIVE_POSTGRES_ACQUIRE_TIMEOUT=5s
BITRIVER_LIVE_POSTGRES_MAX_CONN_LIFETIME=30m
BITRIVER_LIVE_SESSION_STORE=postgres
BITRIVER_LIVE_SESSION_TTL=168h
# Uncomment to enable rolling idle expiry; defaults to disabled
# BITRIVER_LIVE_SESSION_IDLE_TIMEOUT=0
BITRIVER_LIVE_CHAT_QUEUE_DRIVER=redis
BITRIVER_LIVE_CHAT_QUEUE_REDIS_ADDR=redis:6379
BITRIVER_LIVE_CHAT_QUEUE_REDIS_STREAM=bitriver-live-chat
BITRIVER_LIVE_CHAT_QUEUE_REDIS_GROUP=bitriver-live-api
# Optional retention controls. Leave unset to use defaults (recordings) or disable purge (chat).
# BITRIVER_LIVE_RECORDING_RETENTION_PUBLISHED=2160h
# BITRIVER_LIVE_RECORDING_RETENTION_UNPUBLISHED=336h
# BITRIVER_LIVE_CHAT_RETENTION_MESSAGES=0
# BITRIVER_LIVE_CHAT_RETENTION_MODERATION_LOGS=0
# Postgres is internal-only by default. When you need to expose it to the host, set
# COMPOSE_PROFILES=postgres-host and optionally override BITRIVER_POSTGRES_HOST_PORT.
# Restrict firewall rules before enabling the profile.
BITRIVER_POSTGRES_HOST_PORT=5432
BITRIVER_VIEWER_ORIGIN=http://viewer:3000
BITRIVER_SRS_API=http://srs-controller:1985
BITRIVER_OME_API=http://ome:8081
BITRIVER_OME_BIND=0.0.0.0
BITRIVER_OME_HTTP_PORT=8081
BITRIVER_OME_HTTP_TLS_PORT=8082
BITRIVER_OME_IP=0.0.0.0
BITRIVER_OME_SIGNALLING_PORT=9000
BITRIVER_OME_SERVER_PORT=9000
BITRIVER_OME_SERVER_TLS_PORT=9443
BITRIVER_OME_LLHLS_PORT=8080
BITRIVER_OME_LLHLS_TLS_PORT=8443
# Optional: publish LL-HLS on a host port that does not collide with BITRIVER_LIVE_PORT.
BITRIVER_OME_LLHLS_HOST_PORT=8083
BITRIVER_OME_RELAY_PORT=3478
BITRIVER_OME_RELAY_PROTOCOL=tcp
BITRIVER_OME_TCP_RELAY=*:3478
BITRIVER_OME_ICE_PORT_RANGE=10000-10009
BITRIVER_OME_ICE_CANDIDATE=*:10000-10009/udp
BITRIVER_TRANSCODER_API=http://transcoder:9000
# Required: point this at the HTTP origin end users can reach for transcoder outputs.
# Use the public URL exposed by your CDN, reverse proxy, or load balancer (for example,
# https://cdn.example.com/hls). When testing a single host, publish the transcoder
# directory through a routable hostname or IP (not localhost) and set that address here.
# docker compose and deploy/check-env.sh refuse to start when this value is empty or
# loopback-only so operators don’t accidentally advertise an unreachable origin.
BITRIVER_TRANSCODER_PUBLIC_BASE_URL=https://cdn.example.com/hls
BITRIVER_TRANSCODER_HOST_PORT=9001
# Optional transcoder artifact cleanup. Leave empty to disable automatic removal.
# BITRIVER_TRANSCODER_RETENTION_LIVE=168h
# BITRIVER_TRANSCODER_RETENTION_UPLOADS=720h
BITRIVER_INGEST_HEALTH=/healthz
BITRIVER_SRS_CONTROLLER_PORT=1986
SRS_CONTROLLER_UPSTREAM=http://srs:1985/api/
BITRIVER_LIVE_ADMIN_CORS_ORIGINS=https://admin.example.com
BITRIVER_LIVE_VIEWER_CORS_ORIGINS=https://watch.example.com
# Leave this empty when the API proxies the viewer (the quickstart default). Set
# it to the public API origin when serving the viewer on its own hostname.
NEXT_PUBLIC_API_BASE_URL=
NEXT_VIEWER_BASE_PATH=/viewer
NEXT_PUBLIC_VIEWER_URL=https://stream.example.com/viewer
# TLS reverse proxy (deploy/docker-compose.tls.yml)
BITRIVER_PUBLIC_DOMAIN=stream.example.com
BITRIVER_TLS_EMAIL=admin@stream.example.com

# Required credentials – replace every sample before bringing the stack online
BITRIVER_LIVE_ADMIN_EMAIL=admin@stream.example.com
BITRIVER_LIVE_ADMIN_PASSWORD=Sup3rSecureAdmin!
BITRIVER_SRS_TOKEN=srs-secure-token-example
BITRIVER_OME_USERNAME=ome-operator
BITRIVER_OME_PASSWORD=OME-Example-Pass!
BITRIVER_OME_API_TOKEN=OME-Example-Access-Token
# Optional: set only when OME healthchecks must use a different bearer token than
# BITRIVER_OME_API_TOKEN (for example, temporary credential rotation windows).
# Keep deploy/ome/Server.generated.xml in sync by re-rendering after any token
# change so <Managers><API><AccessToken> matches canonical precedence
# (BITRIVER_OME_HEALTHCHECK_TOKEN -> BITRIVER_OME_API_TOKEN).
# BITRIVER_OME_HEALTHCHECK_TOKEN=
# Migration note: if operators still use BITRIVER_OME_ACCESS_TOKEN, copy that value
# into BITRIVER_OME_API_TOKEN (or BITRIVER_OME_HEALTHCHECK_TOKEN for temporary
# override needs) before upgrading to releases that remove legacy fallback support.
# Supported values: accesstoken or basic.
# Use accesstoken for the default OME AccessToken header flow; switch to basic
# only when your OME control API is configured for username/password auth.
BITRIVER_OME_HEALTHCHECK_AUTH_MODE=accesstoken
BITRIVER_TRANSCODER_TOKEN=transcoder-secure-token-example
# Keep this in sync with BITRIVER_REDIS_PASSWORD unless you override the API credential separately.
BITRIVER_LIVE_CHAT_QUEUE_REDIS_PASSWORD=R3dis-Example!
