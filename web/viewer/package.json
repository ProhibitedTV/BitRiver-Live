{
  "name": "bitriver-viewer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "postinstall": "node vendor/brace-expansion-compat/install.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "pretest:playwright": "next build",
    "test:playwright": "playwright test",
    "start:test": "node test/prepare-standalone-server.mjs && node .next/standalone/server.js",
    "test:integration": "npm run lint && npm run test && npm run test:playwright"
  },
  "dependencies": {
    "hls.js": "1.6.16",
    "next": "16.2.11",
    "ovenplayer": "0.10.52",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "brace-expansion": "5.0.8",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.11",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
